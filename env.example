# Configurações do Banco de Dados
# Para desenvolvimento local (SQLite)
DATABASE_URL="file:./atlas.db"

# Para produção na Hostinger (MySQL)
# DATABASE_URL="mysql://usuario:senha@localhost:3306/nome_do_banco"

# Para produção na Hostinger (PostgreSQL)
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco"

# JWT Secret para autenticação
JWT_SECRET="seu-jwt-secret-super-seguro-aqui-mude-em-producao"

# Porta do servidor
PORT=4000

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:3000"

# Modo de produção
NODE_ENV="development"

# Proxy ISP/residencial — fallback SPY quando SPY_SCRAPER=puppeteer
# Refresh de bibliotecas usa IP directo da VPS (não precisa de proxy)
SPY_PROXY_URL=

# Múltiplos proxies ISP em rotação (separados por vírgula)
# SPY_PROXY_URLS=http://user1:pass1@ip1:port1,http://user2:pass2@ip2:port2
SPY_PROXY_URLS=

# SPY scraper: meta | apify | puppeteer | auto
# auto = meta se RESIDENTIAL_PROXY_URL; senão Apify legado; senão puppeteer+SPY_PROXY_URL
SPY_SCRAPER=auto

# Proxy residencial rotating (SPY keyword — NÃO usar no refresh de bibliotecas)
RESIDENTIAL_PROXY_URL=

# SPY Meta — proxy residencial SÓ em biblioteca page_id (não em keyword/deep search)
SPY_META_MAX_ADS_DEFAULT=10000
# Limite escolhido na UI = por keyword (cada pesquisa na biblioteca Meta)
SPY_SESSION_DEFAULT_MAX_ADS=10000
# Teto global opcional na sessão (0 = desactivado)
SPY_SESSION_MAX_ADS_TOTAL=0
SPY_LIBRARY_MAX_DETAIL_FETCHES=100
SPY_META_BATCH_SIZE=50
SPY_META_DELAY_MIN=400
SPY_META_DELAY_MAX=1200
SPY_META_MAX_STAGNANT=8
# Scroll até ao fim (keyword + biblioteca)
SPY_META_SCROLL_TO_END_STAGNANT=40
SPY_META_MAX_SCROLL_ROUNDS=200
SPY_META_MAX_PARALLEL=2
# Scroll guiado por Gemini (keyword + biblioteca quando scroll-fim)
SPY_LIBRARY_AI_SCROLL=true
SPY_LIBRARY_AI_MAX_ROUNDS=120
SPY_KEYWORD_PAUSE_STREAK=4

# Ponte móvel SPY (Mac + iPhone USB) — tráfego Meta via dados móveis
SPY_REQUIRE_MOBILE_BRIDGE=true
SPY_MOBILE_AGENT_SECRET=
SPY_MOBILE_HEARTBEAT_TTL_MS=45000
SPY_MOBILE_JOB_TIMEOUT_MS=600000

# Memória de páginas Meta ouro/rejeitadas (dias de validade do perfil em cache)
SPY_PAGE_CACHE_DAYS=30
SPY_IMPORTED_CACHE_DAYS=90

# Performance SPY
SPY_MAX_KEYWORDS=50
SPY_MAX_LEARNED_KEYWORDS=15
SPY_ENRICH_CONCURRENCY=3
SPY_FAST_DISCOVERY=true
SPY_MIN_ACTIVE_ADS=25
SPY_MOBILE_KEYWORD_TIMEOUT_MS=900000
# Scraper SPY: meta = 100% próprio (ponte móvel + GraphQL Meta). Sem Apify.
SPY_SCRAPER=meta

# Copy Vault (bibliotecas importadas)
COPY_ASSETS_DIR=
COPY_MIN_DAYS_ACTIVE=5
COPY_MIN_DUPLICATES=10
COPY_SCAN_MAX_ADS=80

# Google Gemini (Google AI Studio) — SPY IA directo
GEMINI_API_KEY=
GEMINI_PROJECT=745707961513
VERTEX_PROJECT=745707961513
VERTEX_REGION=us-central1
SPY_ANALYSIS_MODEL=gemini-3.6-flash

# OpenRouter — fallback / Whisper (opcional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Apify legado (opcional se não houver RESIDENTIAL_PROXY_URL)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/facebook-ads-scraper
SPY_APIFY_MAX_ADS=100
SPY_APIFY_TIMEOUT_SEC=180
