# ECOM Task Force - Production Environment Variables
# Copy this file to .env in each app directory

# Database
DATABASE_URL=file:./prisma/atlas.db

# Server Configuration
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# Domain Configuration
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

# Proxy Configuration
PROXY_POOL_SIZE=10
ROTATION_INTERVAL=300
PROXY_ENABLED=true

# Scraping Configuration
SCRAPING_INTERVAL=3600
MAX_CONCURRENT_SCRAPES=5
REQUEST_DELAY=2000
USER_AGENT_ROTATION=true

# Security
JWT_SECRET=your-super-secret-jwt-key-here
API_KEY=your-api-key-here

# Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true
HEALTH_CHECK_INTERVAL=60

# Facebook Scraping
FACEBOOK_TIMEOUT=30000
FACEBOOK_RETRY_ATTEMPTS=3
FACEBOOK_DELAY_BETWEEN_REQUESTS=5000

# OCR Configuration
OCR_LANGUAGE=por
OCR_CONFIDENCE_THRESHOLD=0.7

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Digital Ocean Specific
DO_SPACES_KEY=your-do-spaces-key
DO_SPACES_SECRET=your-do-spaces-secret
DO_SPACES_ENDPOINT=your-do-spaces-endpoint
DO_SPACES_BUCKET=your-bucket-name
