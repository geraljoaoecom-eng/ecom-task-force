generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Folder {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  libraries Library[]
}

model Library {
  id            String      @id @default(cuid())
  name          String
  sourceType    String
  sourceValue   String
  country       String?
  language      String?
  notes         String?
  tags          String?
  activeAds     Int         @default(0)
  lastCheckedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  folderId      String?
  estrategias   String?
  idiomas       String?
  nichos        String?
  paises        String?
  produtos      String?
  status        String?
  tipos         String?
  nota          String?
  adHistory     AdHistory[]
  folder        Folder?     @relation(fields: [folderId], references: [id])
  pages         Page[]

  @@index([activeAds, updatedAt])
}

model Page {
  id        String  @id @default(cuid())
  url       String
  libraryId String
  library   Library @relation(fields: [libraryId], references: [id])
}

model FilterOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type])
}

model AdHistory {
  id        String   @id @default(cuid())
  libraryId String
  adsCount  Int
  date      DateTime @default(now())
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, date])
}
